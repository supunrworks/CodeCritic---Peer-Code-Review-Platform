generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  clerkId     String       @unique
  email       String?      @unique
  name        String?
  avatar      String?
  karma       Int          @default(0)
  createdAt   DateTime     @default(now())
  reviews     Review[]
  submissions Submission[]
}

model Submission {
  id          String   @id @default(uuid())
  title       String
  language    String
  code        String
  description String
  author      String
  avatar      String?
  userId      String
  createdAt   DateTime @default(now())
  reviews     Review[]
  user        User     @relation(fields: [userId], references: [id])
}

model Review {
  id           String     @id @default(uuid())
  strengths    String?
  improvements String?
  submissionId String
  reviewerId   String
  createdAt    DateTime   @default(now())
  reviewer     User       @relation(fields: [reviewerId], references: [id])
  submission   Submission @relation(fields: [submissionId], references: [id])
}
